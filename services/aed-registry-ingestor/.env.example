HJERTESTARTERREGISTER_CLIENT_ID=""
HJERTESTARTERREGISTER_CLIENT_SECRET=""
HJERTESTARTERREGISTER_API_BASE_URL="https://hjertestarterregister.113.no/ords/api/v1/"
HJERTESTARTERREGISTER_OAUTH_TOKEN_URL="https://hjertestarterregister.113.no/ords/api/oauth/token"
DATABASE_URL="postgres://username:password@127.0.0.1:5432/aed_registry_ingestor"
REDIS_URL="redis://127.0.0.1:6379"
REGISTRY_MAX_ROWS="50000"
# Circuit breaker: abort a full sync if it would soft-delete this many AEDs or more.
MAX_DELETIONS_PER_SYNC="50"
# Optional scheduling overrides
INCREMENTAL_SYNC_INTERVAL_MS="900000"
FULL_SYNC_CRON="0 3 * * *"
FULL_SYNC_TIMEZONE="Europe/Oslo"
# Periodic full checkup: re-verify every active AED against OSM (weekly by default).
RECONCILE_CHECKUP_CRON="0 4 * * 0"
LOG_LEVEL="info"
