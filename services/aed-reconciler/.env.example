# Points at the osm-ingestor database (reads osm_aed and osm_aed_history).
DATABASE_URL="postgres://username:password@127.0.0.1:5432/osm_ingestor"
REDIS_URL="redis://127.0.0.1:6379"
QUEUE_NAME="aed-registry-events"
WORKER_RATE_LIMIT_MAX="3"
WORKER_RATE_LIMIT_DURATION_MS="1000"

# Dry-run by default: no changes are uploaded to OSM. Set DRY="false" to go live.
DRY="true"

OSM_API_URL="https://api.openstreetmap.org"
# Required only when DRY="false".
OSM_AUTH_TOKEN=""
OSM_USER_AGENT="Hjertestarterregister2OSM/1.0 (https://github.com/Johannes-Andersen/Hjertestarterregister2OSM)"
# This service's OSM account name. Required to move nodes it placed; when unset,
# location moves are always skipped to avoid overriding community edits.
OSM_SERVICE_USERNAME=""

MERGE_DISTANCE_METERS="175"
MOVE_DISTANCE_METERS="15"
# Grace period before an aed.deleted actually removes the OSM node (default 7 days).
# A reactivation within this window reuses the same node instead of recreating it.
DELETION_GRACE_PERIOD_MS="604800000"

# Optional: write an .osc + .geojson preview per changeset into this folder
# (accumulating over time) for community review. Leave unset to disable.
# PREVIEW_DIR="./preview"

LOG_LEVEL="info"
