{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "DRY",
    "DEV",
    "OSM_AUTH_TOKEN",
    "HJERTESTARTERREGISTER_CLIENT_ID",
    "HJERTESTARTERREGISTER_CLIENT_SECRET",
    "HJERTESTARTERREGISTER_API_BASE_URL",
    "HJERTESTARTERREGISTER_OAUTH_TOKEN_URL",
    "DATABASE_URL",
    "REDIS_URL",
    "REGISTRY_MAX_ROWS",
    "OSM_PLANET_URL",
    "OSM_PLANET_FILE_PATH",
    "OSM_PLANET_RETAIN_DOWNLOADS",
    "OSM_REPLICATION_BASE_URL",
    "OSM_PLANET_BATCH_SIZE",
    "OSM_REPLICATION_POLL_INTERVAL_MS",
    "OSM_RETRY_DELAY_MS",
    "OSM_USER_AGENT",
    "LOG_LEVEL",
    "TZ"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".astro/**", "dist/**"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
